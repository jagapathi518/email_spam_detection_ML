# SpamGuard AI Environment Variables

# Port for the web server (Render sets this automatically)
PORT=5000

# Flask environment
FLASK_ENV=development

# Contact email for feedback links
CONTACT_EMAIL=your-email@example.com

# GitHub repo URL for issues link
GITHUB_REPO_URL=https://github.com/jagapathi518/email_spam_detection_ML

# Rate limiting (optional overrides)
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_PER_DAY=200

# Supabase PostgreSQL database URL (optional for privacy-safe scan analytics & feedback)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

